---
import type { Content } from '../content/schema';
import { localePaths } from '../content/locale-paths';

interface Props {
  content: Content;
  lang: 'nb' | 'en';
}

const { content, lang } = Astro.props;
const path = Astro.url.pathname;
const home = lang === 'en' ? '/en/' : '/';
const normalized = path.replace(/\/+$/, '') || '/';
const isHome = normalized === '/' || normalized === '/en';
const sectionBase = isHome ? '' : home;
const otherLang = lang === 'en' ? 'nb' : 'en';
const otherHref = localePaths(path)[otherLang];
const navLabel = lang === 'en' ? 'Main' : 'Hovedmeny';
const links = [
  { href: `${sectionBase}#bygget`, hash: '#bygget', label: content.nav.house },
  { href: `${sectionBase}#materialer`, hash: '#materialer', label: content.nav.materials },
  { href: `${sectionBase}#flytting`, hash: '#flytting', label: content.nav.moving },
  { href: `${sectionBase}#sporsmal`, hash: '#sporsmal', label: content.nav.questions },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={home}>MiniHouse</a>
    <nav class="nav" aria-label={navLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav-hash={link.hash}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={otherHref} lang={otherLang} hreflang={otherLang} data-keep-hash>{content.nav.language}</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="meny" aria-haspopup="dialog">{content.nav.menu}</button>
  </div>
  <dialog class="menu-sheet" id="meny" aria-label={content.nav.menu}>
    <button class="menu-close" type="button" autofocus>{content.nav.close}</button>
    <nav class="sheet-nav" aria-label={navLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav-hash={link.hash}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={otherHref} lang={otherLang} hreflang={otherLang} data-keep-hash>{content.nav.language}</a>
  </dialog>
</header>

<script>
  const opener = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLDialogElement>('.menu-sheet');
  const desktop = window.matchMedia('(min-width: 64rem)');

  opener?.addEventListener('click', () => {
    menu?.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });
  menu?.querySelector('.menu-close')?.addEventListener('click', () => menu.close());
  menu?.addEventListener('close', () => opener?.setAttribute('aria-expanded', 'false'));
  desktop.addEventListener('change', () => {
    if (desktop.matches && menu?.open) menu.close();
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));

  const syncCurrent = () => {
    const home = document.getElementById('bygget');
    const active = home ? location.hash || '#bygget' : '';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-hash]').forEach((link) => {
      if (link.dataset.navHash === active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  syncCurrent();
  window.addEventListener('hashchange', syncCurrent);
</script>
