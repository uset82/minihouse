---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { images } from '../content/assert-images';
import type { ImageId } from '../content/images';

interface Props {
  imageId: ImageId;
  lang: 'nb' | 'en';
  class?: string;
  ratio: 'hero' | 'texture' | 'wide' | 'room' | 'tile' | 'step';
  plain?: boolean;
}

const { imageId, lang, class: className, ratio, plain = false } = Astro.props;
const image = images.find((entry) => entry.id === imageId);
const masters = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpg,jpeg,png,webp}');
const load = image?.file ? masters[`../assets/images/${image.file}`] : undefined;
const source = load ? (await load()).default : undefined;
const sizes = {
  hero: '(min-width: 1024px) 56vw, 100vw',
  wide: '(min-width: 1280px) 800px, (min-width: 1024px) 62vw, 100vw',
  tile: '(min-width: 1280px) 520px, (min-width: 768px) 40vw, 80vw',
  room: '(min-width: 1280px) 560px, (min-width: 768px) 47vw, 96vw',
  texture: '(min-width: 1280px) 380px, (min-width: 768px) 33vw, 60vw',
  step: '(min-width: 1280px) 380px, (min-width: 768px) 31vw, 100vw',
};
const widths = source
  ? Array.from(new Set([480, 960, 1600, 2400].map((width) => Math.min(width, source.width))))
  : [];
const priority = ratio === 'hero';
const Wrapper = plain ? 'span' : 'figure';
const Caption = plain ? 'span' : 'figcaption';
---

{image && source && image.alt[lang] && image.alt[lang] !== 'TODO' && (
  <Wrapper class={className}>
    <Picture
      src={source}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={widths}
      sizes={sizes[ratio]}
      alt={image.alt[lang]}
      class={`ratio-${ratio}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      style={{ objectPosition: image.focal }}
    />
    {image.caption[lang] && <Caption class="tile-caption">{image.caption[lang]}</Caption>}
  </Wrapper>
)}
