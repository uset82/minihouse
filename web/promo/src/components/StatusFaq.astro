---
import type { Content } from '../content/schema';

interface Props {
  content: Content;
}

const { content } = Astro.props;
---

<section class="status-faq" id="sporsmal" aria-labelledby="status-title">
  <div class="wrap">
    <h2 id="status-title">{content.status.title}</h2>
    <p class="section-lead">{content.status.body}</p>
    <div class="status-phases">
      {
        content.status.phases.map((phase) => (
          <div>
            <p>{phase.name}</p>
            <p>{phase.state}</p>
          </div>
        ))
      }
    </div>
    <h2 id="faq-title">{content.faq.title}</h2>
    <div class="faq">
      {
        content.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
