---
import type { Content } from '../content/schema';
import type { ImageId } from '../content/images';
import Figure from './Figure.astro';

interface Props {
  content: Content;
  lang: 'nb' | 'en';
}

/*
 * «Fra verksted til tomt» (DESIGN-GUIDE §6.9): three steps, each under a giant
 * wood-type numeral that overlaps the top of its photo like a stamp on a crate.
 * The <ol> gives the order to screen readers, so the numerals are aria-hidden.
 */
const { content, lang } = Astro.props;
const images: ImageId[] = ['journey-workshop', 'journey-truck', 'journey-plot'];
---

<section class="journey" id="flytting" aria-labelledby="journey-title">
  <div class="wrap">
    <h2 id="journey-title">{content.journey.title}</h2>
    <ol class="journey-steps" role="list">
      {
        content.journey.steps.map((step, index) => (
          <li class="journey-step">
            <span class="numeral" aria-hidden="true">{index + 1}</span>
            <Figure imageId={images[index] ?? 'journey-workshop'} lang={lang} ratio="step" class="journey-image" />
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
