---
import type { Content } from '../content/schema';
import type { ImageId } from '../content/images';
import Figure from './Figure.astro';

interface Props {
  content: Content;
  lang: 'nb' | 'en';
}

const { content, lang } = Astro.props;
const images: ImageId[] = ['journey-workshop', 'journey-truck', 'journey-plot'];
---

<section class="journey" id="flytting" aria-labelledby="journey-title">
  <div class="wrap">
    <h2 id="journey-title">{content.journey.title}</h2>
    <ol class="journey-steps" role="list">
      {
        content.journey.steps.map((step, index) => (
          <li class="journey-step">
            <h3 class="journey-step-heading">
              <span class="journey-step-num" aria-hidden="true">
                {index + 1}
              </span>
              <span class="journey-step-name">{step.title}</span>
            </h3>
            <Figure
              imageId={images[index] ?? 'journey-workshop'}
              lang={lang}
              ratio="journey"
              class="journey-image"
            />
            <p class="journey-step-copy">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .journey-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-step {
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    grid-template-areas:
      'image heading'
      'image copy';
    column-gap: var(--space-3);
    row-gap: var(--space-2);
    align-items: start;
  }

  .journey-step-heading {
    grid-area: heading;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-weight: 800;
    font-size: var(--size-h3);
  }

  .journey-step-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-h2);
    line-height: var(--leading-display);
    letter-spacing: -0.01em;
    color: var(--malmfuru);
  }

  .journey-step-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-h3);
    line-height: var(--leading-display);
    letter-spacing: -0.01em;
  }

  .journey-step :global(.journey-image) {
    grid-area: image;
    margin: 0;
    width: 100%;
    min-inline-size: 0;
  }

  .journey-step :global(.journey-image picture),
  .journey-step :global(.journey-image img) {
    width: 100%;
    max-inline-size: 100%;
    height: auto;
    object-fit: contain;
  }

  .journey-step > .journey-step-copy {
    grid-area: copy;
    margin: 0;
    max-width: var(--measure);
    font-size: var(--size-body);
    line-height: var(--leading-text);
  }

  @media (min-width: 48rem) {
    .journey-steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      align-items: stretch;
    }

    .journey-step {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "heading" "image" "copy";
      row-gap: var(--space-3);
    }

    .journey-step-num {
      font-size: var(--size-h1);
    }

    .journey-step :global(.journey-image) {
      /* Keep the three prints at a comparable height without cropping their subjects. */
      width: min(100%, calc((var(--space-7) + 2 * var(--space-4)) * var(--photo-ratio)));
    }
  }
</style>
