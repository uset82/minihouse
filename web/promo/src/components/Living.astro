---
import type { Content } from '../content/schema';
import { getFilm } from '../content/films';
import Figure from './Figure.astro';
import Film from './Film.astro';
import MirrorFrame from './MirrorFrame.astro';

interface Props {
  content: Content;
  lang: 'nb' | 'en';
}

/*
 * «Inne i MiniHouse» (DESIGN-GUIDE §6.8): the petrol-green tile wall, with the copper
 * mirror hanging beside the living room. The concept film carries on here (§6.15): the
 * living-room shot plays in the photo's place, and the bathroom shot plays inside the
 * mirror. Without the film media, both fall back to the still photos.
 */
const { content, lang } = Astro.props;
const hasFilm = getFilm('living') !== undefined;
---

<section class="band--irr living" id="bo" aria-labelledby="living-title">
  <div class="wrap living-grid">
    <div class="living-text">
      <h2 id="living-title">{content.living.title}</h2>
      <p class="section-lead">{content.living.lead}</p>
    </div>
    {
      hasFilm ? (
        <Film
          id="living"
          class="living-photo"
          label={content.film.livingAlt}
          caption={content.film.caption}
          play={content.film.play}
          pause={content.film.pause}
          sizes="(min-width: 1280px) 800px, (min-width: 1024px) 62vw, 100vw"
        />
      ) : (
        <Figure imageId="living" lang={lang} class="living-photo" ratio="wide" />
      )
    }
    <MirrorFrame
      imageId="bath-window"
      lang={lang}
      class="living-mirror"
      film="bath"
      filmLabel={content.film.bathAlt}
      filmCaption={content.film.caption}
    />
  </div>
</section>
